<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash: Material 3 + DayNight (aligned with edge-to-edge / Android 15) -->
    <style name="LaunchTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Post-startup theme: no legacy statusBarColor/navigationBarColor here — bars are
         handled by enableEdgeToEdge() + Flutter SafeArea (avoids deprecated Window APIs where possible). -->
    <style name="NormalTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- API 28+; ignored on older devices -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
