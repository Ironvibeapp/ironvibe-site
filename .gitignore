# Flutter app lives in Flutter/. Build output is also ignored by Flutter/.gitignore.
Flutter/build/
Flutter/.dart_tool/

# Local Chrome profile used to check the site. Holds cookies and cache.
_tmp_site/

# Signing — never commit
**/key.properties
**/*.jks
**/*.keystore

# Local release archives (versioned copies on the maintainer machine)
/IronVibe-1.*.apk
/IronVibe-1.*.aab
/IronVibe-*.symbols/

# IDE
.idea/
*.iml
.continue/

# OS
.DS_Store
Thumbs.db

# Web / tooling
node_modules/

# Local clones / deploy scratch (not part of this repo)
ironvibe-site-push/
ironvibe-site-work/
